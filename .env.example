# Copy to .env and fill in. .env is git-ignored.

# GPU server running server_train/serve_v13_api.py (backend server_gpu, the default)
SERVER_GPU_URL=http://192.168.91.176:6868
# SERVER_GPU_API_KEY=            # only if the server was started with an API key
# SERVER_GPU_TEMPERATURE=0.2

# --backend ollama: Advisor/Assessor through a local Ollama model
OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_TEMPERATURE=0.2
# MAX_LLM_ADVISOR_CALLS=5

# Agents built with backend="auto" read LLM_BACKEND (server_gpu | ollama | gemini).
# No pipeline backend uses Gemini today; the client is kept in E2E/agents/llm_client.py.
LLM_BACKEND=ollama
# GEMINI_API_KEY=
# GEMINI_GENERATION_MODEL=gemini-2.5-flash
# GEMINI_TEMPERATURE=0.2

# SmartBugs checkout used for the 9-tool matrix (default: .tools/smartbugs)
# SMARTBUGS_HOME=
