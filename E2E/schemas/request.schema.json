{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.e2e.audit/schemas/request.schema.json",
  "title": "CodeLlama E2E Audit Request",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "source",
    "code_units",
    "local_phase1",
    "execution"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["file_name", "sha256", "code"],
      "properties": {
        "file_name": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "code": {"type": "string", "minLength": 1}
      }
    },
    "code_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "kind", "name", "code", "start_line", "end_line"]
      }
    },
    "local_phase1": {
      "type": "object",
      "required": ["static", "rag", "provisional_fusion"]
    },
    "execution": {
      "type": "object",
      "required": ["mode", "detector_threshold"],
      "properties": {
        "mode": {"enum": ["detector_only", "agents_only", "full"]},
        "detector_threshold": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
