# Copy to .env and fill in. .env is git-ignored.

# GPU server running gpu_server/serve_v13_api.py (Qwen2.5-Coder-14B + LoRA v13)
SERVER_GPU_URL=http://192.168.91.176:6868
# SERVER_GPU_API_KEY=            # only if the server was started with an API key
# SERVER_GPU_TEMPERATURE=0.2     # sampling temperature of the Advisor / Assessor client
# SERVER_GPU_TIMEOUT=300         # seconds per detect/generate call (default 60/120; Kaggle T4 is slower)

# GPU server on Kaggle instead (written by: .venv/bin/python scripts/kaggle_server.py setup)
# SERVER_GPU_URL=https://<your-domain>.ngrok-free.app
# SERVER_GPU_API_KEY=<random>     # also sent to the Kaggle kernel
# NGROK_AUTHTOKEN=<from dashboard.ngrok.com>
# SERVER_GPU_DTYPE=fp16           # Kaggle default fp16 (T4 has no native bf16); bf16 = same as training, 2-3x slower on T4
# .env values override variables already set in the shell. LLM call budgets are in E2E/config.py.
