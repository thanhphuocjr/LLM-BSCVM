# Only code, scripts, small configs and docs are pushed.
# Datasets, run results, model weights and local tools stay on this machine.

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# ── OS / IDE / local tools ────────────────────────────────────────────────────
.DS_Store
._*
.vscode/
.idea/
*.swp
.tools/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Data, results and models (local only; layout in data/README.md) ──────────
data/*
!data/README.md
!data/data_manifest.json
models/

# ── Heavy formats anywhere else ───────────────────────────────────────────────
*.log
*.pid
*.csv
*.tsv
*.jsonl
*.parquet
*.sqlite
*.sqlite3
*.db
*.npz
*.npy
*.joblib
*.pkl
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.ckpt
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
*.pdf

# Solidity sources are data, except the demo contracts used by the web app and the tests
*.sol
!demo_contracts/*.sol

# KLTN
graduation thesis/

