# Only code, scripts, small configs and docs are pushed.
# Datasets, model weights, run outputs and local tools stay on this machine.

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# ── OS / IDE / local tools ────────────────────────────────────────────────────
.DS_Store
._*
.vscode/
.idea/
*.swp
.tools/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Data and models (local only) ──────────────────────────────────────────────
E2E/data/
models/
server_train/*.json
docs/*.pdf

# ── Run outputs ───────────────────────────────────────────────────────────────
E2E/runs/*
!E2E/runs/.gitkeep
E2E/batch_runs/
E2E/phase1_detection.json
E2E/audit_report.*
results/
kaggle-kernel-build/
kaggle-output*/
*.log
*.pid

# ── Heavy formats anywhere else ───────────────────────────────────────────────
*.csv
*.tsv
*.jsonl
*.parquet
*.sqlite
*.sqlite3
*.db
*.npz
*.npy
*.joblib
*.pkl
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.ckpt
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
*.pdf

# Solidity sources are data, except the bundled examples used by tests and the web UI
*.sol
!E2E/examples/*.sol
